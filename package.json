{
  "name": "leetify-codeforces",
  "version": "3.0.0",
  "private": true,
  "description": "A Firefox extension that turns Codeforces problem pages into a focused coding workspace.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src scripts tests/unit",
    "test": "node --test tests/unit/*.test.js tests/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "check:extension": "addons-linter dist --warnings-as-errors",
    "check": "npm run lint && npm test && npm run build",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "addons-linter": "^10.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9"
  }
}
